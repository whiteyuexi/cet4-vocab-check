/* 设置页样式：分段控件、步进器、行式开关 */
.sect { margin-bottom: 20rpx; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; }
.row-l { flex: 1; min-width: 0; padding-right: 20rpx; }
.row-l .t3 { margin-top: 4rpx; }

.seg { display: flex; background: #F3F5FA; border-radius: 18rpx; padding: 6rpx; }
.seg-i {
  flex: 1; text-align: center; padding: 18rpx 0; border-radius: 14rpx;
  font-size: 27rpx; color: #575E6B;
}
.seg-i.on { background: #2A5BE0; color: #FFFFFF; font-weight: 700; }

.stepper { display: flex; align-items: center; justify-content: center; gap: 28rpx; margin-top: 24rpx; }
.step-btn {
  width: 84rpx; height: 84rpx; border-radius: 24rpx; background: #F3F5FA;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: #101319; border: 1rpx solid rgba(16,19,25,.06);
}
.step-btn:active { background: #E9EDF6; }
.step-val { min-width: 200rpx; text-align: center; }
.step-num { font-size: 52rpx; font-weight: 700; font-family: ui-monospace, Consolas, monospace; }
