<!-- 设置：影响结果的那几项 + 数据/关于 -->
<view class="page">

  <view class="card">
    <view class="t1 sect">答题设置</view>

    <view class="row">
      <view class="row-l">
        <view class="t2 bold">答题方式</view>
        <view class="t3">自评最快；四选一更能检验真实记忆</view>
      </view>
    </view>
    <view class="seg">
      <view class="seg-i {{mode === 'self' ? 'on' : ''}}" data-mode="self" bindtap="onMode">自评三档</view>
      <view class="seg-i {{mode === 'choice' ? 'on' : ''}}" data-mode="choice" bindtap="onMode">四选一</view>
    </view>

    <view class="hr"></view>

    <view class="row">
      <view class="row-l">
        <view class="t2 bold">严格口径</view>
        <view class="t3">只把「认识」算掌握；关闭时「模糊」按一半计入</view>
      </view>
      <switch checked="{{strict}}" bindchange="onStrict" color="#2A5BE0" />
    </view>

    <view class="row">
      <view class="row-l">
        <view class="t2 bold">包含拓展派生词</view>
        <view class="t3">在核心词之外加常见派生词，当前词库 {{wordCount}} 词</view>
      </view>
      <switch checked="{{includeExt}}" bindchange="onExt" color="#2A5BE0" />
    </view>
  </view>

  <!-- 每日可投入时间：这一栏决定所有"要几天"的文案 -->
  <view class="card">
    <view class="t1 sect">每日可投入时间</view>
    <view class="t3" style="margin-bottom:20rpx">只用来把时间换算成"每天背多少词"，不影响出题。</view>

    <view class="seg">
      <view class="seg-i {{dailyMinutes === 15 ? 'on' : ''}}" data-min="15" bindtap="onDaily">15 分钟</view>
      <view class="seg-i {{dailyMinutes === 30 ? 'on' : ''}}" data-min="30" bindtap="onDaily">30 分钟</view>
      <view class="seg-i {{dailyMinutes === 60 ? 'on' : ''}}" data-min="60" bindtap="onDaily">60 分钟</view>
    </view>

    <view class="stepper">
      <view class="step-btn" data-step="-5" bindtap="onDailyStep">−</view>
      <view class="step-val">
        <text class="num step-num">{{dailyMinutes}}</text>
        <text class="t3"> 分钟</text>
      </view>
      <view class="step-btn" data-step="5" bindtap="onDailyStep">＋</view>
    </view>

    <view class="t3" style="margin-top:12rpx">
      当前：每天 <text class="bold">{{dailyMinutes}}</text> 分钟 ≈ <text class="bold accent">{{perDay}}</text> 个词/天（每词约 1.5 分钟）。
      <text wx:if="{{isPreset}}">可点 −／＋ 自定义，范围 5–180。</text>
    </view>
  </view>

  <!-- 回访提醒 -->
  <view class="card">
    <view class="t1 sect">回访提醒</view>
    <view class="row" style="padding-top:0">
      <view class="row-l">
        <view class="t2 bold">首页给一句话分析</view>
        <view class="t3">距上次检测满 {{gapDays}} 天才出现；可随时关闭</view>
      </view>
      <switch checked="{{!revisitOff}}" bindchange="onRevisit" color="#2A5BE0" />
    </view>
  </view>

  <!-- 数据 -->
  <view class="card">
    <view class="t1 sect">数据</view>
    <view class="t3" style="margin-bottom:20rpx">
      已记录 {{testedCount}} 个词的作答。数据只存在这台手机上，换手机或清理小程序会丢失。
    </view>
    <view class="btn" bindtap="onExport">复制成绩单到剪贴板</view>
    <view class="btn btn-ghost" style="margin-top:16rpx" bindtap="onClear">清空作答记录</view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="t1 sect">关于</view>
    <view class="t3">四六级词汇量检测 · 微信小程序版 v{{version}}</view>
    <view class="t3" style="margin-top:8rpx">
      词库与统计引擎与网页版同源；例句来自 Tatoeba（CC-BY 2.0 FR）。不注册、不上传、不弹广告。
    </view>
    <view class="btn btn-ghost" style="margin-top:20rpx" bindtap="onAbout">数据来源与说明</view>
  </view>

</view>
