/* 首页样式 */
.brand { display: flex; align-items: center; gap: 20rpx; padding: 8rpx 4rpx 28rpx; }
.mark {
  width: 84rpx; height: 84rpx; border-radius: 24rpx;
  background: #2A5BE0; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700;
  box-shadow: 0 12rpx 26rpx -14rpx rgba(42,91,224,.7);
}
.brand-txt { flex: 1; }

/* 余额卡 */
.hero { padding: 34rpx 32rpx 28rpx; }
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.hero-label { font-size: 25rpx; color: #6B7280; letter-spacing: 1rpx; }
.hero-num { font-size: 96rpx; font-weight: 700; line-height: 1.1; letter-spacing: -2rpx; margin: 12rpx 0 4rpx; }
.hero-num .unit { font-size: 30rpx; font-weight: 600; margin-left: 10rpx; color: #6B7280; }
.hero-sub { font-size: 24rpx; color: #575E6B; }
.hero-meta { display: flex; margin: 26rpx 0 20rpx; gap: 12rpx; }
.mi { flex: 1; background: #F5F7FB; border-radius: 18rpx; padding: 16rpx 18rpx; }
.mi-k { font-size: 21rpx; color: #8B93A3; }
.mi-v { font-size: 32rpx; font-weight: 700; margin-top: 2rpx; }
.hero-bar { height: 12rpx; }
.hero-foot { margin-top: 14rpx; }

/* 继续检测 */
.resume { display: flex; align-items: center; justify-content: space-between; background: #2A5BE0; }
.resume .t2, .resume .t3 { color: rgba(255,255,255,.86); }
.resume-r { color: #fff; font-weight: 700; font-size: 27rpx; }

/* 入口 */
.sect { font-size: 30rpx; margin-bottom: 8rpx; }
.sect-row { display: flex; align-items: baseline; justify-content: space-between; }
.row-note { margin: 6rpx 0 22rpx; line-height: 1.5; }
.entry {
  display: flex; align-items: center; justify-content: space-between;
  height: auto; padding: 24rpx 26rpx; margin-bottom: 16rpx;
  text-align: left;
}
.entry-l { flex: 1; }
.entry-t { font-size: 30rpx; font-weight: 700; }
.entry-d { font-size: 22rpx; opacity: .78; margin-top: 4rpx; font-weight: 400; }
.entry-go { font-size: 30rpx; margin-left: 16rpx; opacity: .8; }

/* 分组网格 */
.grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.gcell {
  width: calc((100% - 42rpx) / 4);
  border-radius: 16rpx; background: #F5F7FB;
  padding: 14rpx 0; text-align: center;
  border: 1rpx solid rgba(16,19,25,.05);
}
.gcell-n { font-size: 28rpx; font-weight: 700; }
.gcell-p { font-size: 19rpx; color: #8B93A3; }
.gpart { background: rgba(42,91,224,.08); border-color: rgba(42,91,224,.22); }
.gpart .gcell-n { color: #2A5BE0; }
.gdone { background: #E7F5EF; border-color: rgba(10,107,74,.18); }
.gdone .gcell-n, .gdone .gcell-p { color: #0A6B4A; }

.footer-links { text-align: center; padding: 10rpx 0 8rpx; }
.tip { margin-top: 18rpx; }
.center { text-align: center; }
