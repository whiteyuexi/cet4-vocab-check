/* AI 诊断页 */
.quick { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.quick-i {
  padding: 12rpx 22rpx; border-radius: 999rpx; font-size: 24rpx;
  background: #F3F5FA; color: #575E6B; border: 1rpx solid rgba(16,19,25,.08);
}
.quick-i.on { background: rgba(42,91,224,.10); color: #2A5BE0; border-color: rgba(42,91,224,.35); font-weight: 600; }
.quick-i:active { opacity: .75; }

.blk-h { font-size: 26rpx; font-weight: 700; margin-bottom: 10rpx; }
.blk-h::before { content: ""; display: inline-block; width: 8rpx; height: 22rpx; border-radius: 4rpx; background: #2A5BE0; margin-right: 12rpx; vertical-align: -3rpx; }
.blk-l { font-size: 24rpx; line-height: 1.78; color: #575E6B; margin-bottom: 8rpx; }
