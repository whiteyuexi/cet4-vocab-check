{
  "name": "cet-vocab-checker",
  "version": "0.1.0",
  "private": true,
  "description": "四六级词汇量检测 · 基于词频分层抽样的自适应词汇量测评与 AI 诊断工具",
  "keywords": [
    "cet4",
    "cet6",
    "vocabulary",
    "adaptive-testing",
    "stratified-sampling",
    "ai-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "server": "node server/index.mjs",
    "data": "node scripts/fetch-data.mjs && node build-data.js",
    "pet:fetch": "node scripts/fetch-live2d.mjs",
    "art:fetch": "node scripts/fetch-whale-art.mjs",
    "art:sprite": "node scripts/make-whale-sprites.mjs",
    "build": "node build.js",
    "test": "node smoke-test.js",
    "test:browser": "node scripts/run-btest.mjs",
    "test:pet": "node scripts/pet-test.mjs",
    "test:agent": "node scripts/test-agent-tokens.mjs",
    "audit": "node audit-fixes.js",
    "shots": "node shots.js",
    "shot": "node scripts/cdp-shot.mjs",
    "all": "npm run build && npm test && npm run audit",
    "ppt": "node scripts/make-deck.mjs roadshow",
    "ppt:shots": "node scripts/make-ppt-shots.mjs",
    "ppt:check": "py scripts/pptx-check.py",
    "ppt:detail": "node scripts/make-deck.mjs detail",
    "logo:font": "node scripts/make-logo-from-font.mjs",
    "logo:assets": "node scripts/make-logo-assets.mjs",
    "logo:ai": "node scripts/process-ai-logo.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.0.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "potrace": "^2.1.8",
    "pptxgenjs": "^4.0.1"
  }
}
