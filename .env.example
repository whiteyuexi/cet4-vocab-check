# ============================================================
# 四六级词汇量检测 · 环境变量模板
# 用法：复制成 .env 再填值。.env* 已在 .gitignore 里，不会被提交。
# 只有需要"在线 AI 诊断"时才用得上；单文件产物不需要任何环境变量。
# ============================================================

# 后端端口（默认 8787）
PORT=8787

# 模型提供方：deepseek | qwen | zhipu | ollama | mock
#   mock  = 不调用任何外部模型，走本地规则（离线演示用）
LLM_PROVIDER=deepseek

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- 通义千问（OpenAI 兼容模式）---
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# --- 智谱 GLM ---
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# --- 本地 Ollama（不需要 Key）---
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
